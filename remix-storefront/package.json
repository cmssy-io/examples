{
  "name": "cmssy-example-remix-storefront",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "build:local": "LOCAL_SERVE=1 react-router build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "smoke:edit": "node --env-file-if-exists=.env.local scripts/smoke-edit.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "types": "cmssy types --out app/graphql/models.ts"
  },
  "dependencies": {
    "@cmssy/core": "^19.1.0",
    "@cmssy/react": "^19.1.0",
    "@cmssy/remix": "^19.1.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@vercel/react-router": "^1.3.4",
    "cookie-es": "^3.1.1",
    "isbot": "^5.2.1",
    "jose": "^6.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sanitize-html": "^2.17.7",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@cmssy/cli": "^19.1.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "graphql": "^17.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "description": "A storefront on cmssy, on React Router (Remix): products, categories, cart, checkout, member accounts and orders as route actions.",
  "packageManager": "pnpm@11.1.2"
}

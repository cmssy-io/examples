{
  "name": "cmssy-example-remix-storefront",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "build:local": "LOCAL_SERVE=1 react-router build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "smoke:edit": "node --env-file-if-exists=.env.local scripts/smoke-edit.mjs"
  },
  "dependencies": {
    "@cmssy/core": "^12.6.0",
    "@cmssy/react": "^12.6.0",
    "@cmssy/remix": "^12.6.0",
    "@react-router/node": "^7.5.0",
    "@react-router/serve": "^7.5.0",
    "@vercel/react-router": "^1.1.0",
    "isbot": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "description": "A cmssy site on React Router (Remix): the catch-all route, block registry and verified edit mode.",
  "packageManager": "pnpm@11.1.2"
}

{
  "name": "cmssy-example-remix-storefront",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "build:local": "LOCAL_SERVE=1 react-router build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "smoke:edit": "node --env-file-if-exists=.env.local scripts/smoke-edit.mjs"
  },
  "dependencies": {
    "@cmssy/core": "^15.0.0",
    "@cmssy/react": "^15.0.0",
    "@cmssy/remix": "^15.0.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@vercel/react-router": "^1.3.4",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "description": "A cmssy site on React Router (Remix): the catch-all route, block registry and verified edit mode.",
  "packageManager": "pnpm@11.1.2"
}

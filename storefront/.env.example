# Points at the public cmssy demo workspace, so this example renders real content on a
# fresh clone with no cmssy account. Copy to .env.local and run.
#
# For your own workspace: npx @cmssy/cli link --token cs_...

CMSSY_ORG_SLUG=cmssy
CMSSY_WORKSPACE_SLUG=cmssy-demo

# Only verified for draft preview and editing, which need your own workspace.
CMSSY_DRAFT_SECRET=example-placeholder-draft-secret

# Signs cart/customer session cookies. Any long random string; generate your own
# for anything you deploy: openssl rand -base64 32
CMSSY_SESSION_SECRET=example-placeholder-session-secret-change-me

{
  "name": "cmssy-example-astro-storefront",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:local": "LOCAL_SERVE=1 astro build",
    "start": "node --env-file-if-exists=.env.local ./dist/server/entry.mjs",
    "smoke:edit": "node --env-file-if-exists=.env.local smoke-edit.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/vercel": "^11.0.5",
    "@cmssy/astro": "^12.14.1",
    "@cmssy/core": "^12.14.1",
    "@cmssy/react": "^12.14.1",
    "astro": "^7.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "description": "A cmssy site on Astro: the catch-all route, block registry and verified edit mode with the Astro adapter.",
  "packageManager": "pnpm@11.1.2"
}

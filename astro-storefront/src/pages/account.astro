---
import ShopLayout from "../layouts/shop-layout.astro";
import { AccountPageIsland } from "../islands/account-page";
import { copyFor } from "../lib/shop-copy";
import { listMyOrders } from "../services/orders";
import { memberAccessToken } from "../shop/context";
import { shopPageState } from "../shop/page-state";

export const prerender = false;

const state = await shopPageState(Astro);
const copy = copyFor(state.location.locale);
const orders = state.user
  ? (await listMyOrders(memberAccessToken(Astro.locals.shop))).items
  : [];
---

<ShopLayout state={state} title={`${copy.tradeAccount} - MACHTEC`} noindex>
  <h1 style="margin-top: 0">{copy.tradeAccount}</h1>
  <AccountPageIsland
    client:load
    shop={state}
    orders={orders}
    payOnline={state.payOnline}
  />
</ShopLayout>

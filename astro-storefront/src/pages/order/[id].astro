---
import styles from "../../components/shop/order.module.css";
import {
  OrderReceipt,
  paymentLabel,
  progressLabel,
  showsPayment,
} from "../../components/shop/order-receipt";
import { OrderCustomFields } from "../../components/shop/order-fields";
import ShopLayout from "../../layouts/shop-layout.astro";
import { localePath } from "../../lib/locale-path";
import { copyFor } from "../../lib/shop-copy";
import { visitorAddress } from "../../lib/cmssy/visitor-headers";
import { fetchOrderByToken } from "../../services/orders";
import { fetchShopSettings } from "../../services/site";
import { shopPageState } from "../../shop/page-state";

export const prerender = false;

const state = await shopPageState(Astro);
const { locale, defaultLocale } = state.location;
const copy = copyFor(locale);
const id = Astro.params.id ?? "";
const token = Astro.url.searchParams.get("token");
const href = (path: string) => localePath(path, locale, defaultLocale);

const order = token
  ? await fetchOrderByToken(id, token, visitorAddress(Astro.request.headers))
  : null;
const orderFields = order ? (await fetchShopSettings()).orderFields : [];
if (!order) {
  Astro.response.status = 404;
}
---

<ShopLayout state={state} title={`${copy.orderConfirmation} - MACHTEC`} noindex>
  {!order ? (
    <div class={`shop-card ${styles.notFound}`}>
      <h1>{copy.orderNotFound}</h1>
      <p class="shop-muted">{copy.orderLinkExpired}</p>
      <a class="shop-btn" href={href("/c/all")}>{copy.continueShopping}</a>
    </div>
  ) : (
    <div class={styles.page}>
      <div class={styles.head}>
        <span class={styles.mark} aria-hidden>
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        <h1 class={styles.title}>{copy.orderPlaced}</h1>
        <p class={styles.subtitle}>
          {order.orderNumber ? (
            <>
              {copy.order} <span class={styles.strong}>#{order.orderNumber}</span>{" · "}
            </>
          ) : null}
          {order.poNumber ? (
            <>
              {copy.po} <span class={styles.strong}>{order.poNumber}</span>{" · "}
            </>
          ) : null}
          {copy.confirmationSentTo}{" "}
          <span class={styles.strong}>{order.customerEmail}</span>
        </p>
        <div class={styles.badges}>
          <span class={styles.badge}>{progressLabel(order, copy)}</span>
          {showsPayment(order) ? (
            <span class={styles.badge}>{paymentLabel(order, copy)}</span>
          ) : null}
        </div>
      </div>

      <OrderReceipt order={order} copy={copy} locale={locale} />

      <OrderCustomFields
        values={order.customFields}
        fields={orderFields}
        locale={{ locale, defaultLocale }}
        copy={copy}
      />

      {order.customerNote ? (
        <div class={styles.meta}>
          <div class={styles.metaRow}>
            <span class={styles.metaLabel}>{copy.note}</span>
            <span>{order.customerNote}</span>
          </div>
        </div>
      ) : null}

      <div class={styles.actions}>
        <a class="shop-btn shop-btn-primary" href={href("/c/all")}>{copy.continueShopping}</a>
        {order.invoiceUrl ? (
          <a class="shop-btn" href={order.invoiceUrl}>{copy.downloadInvoice}</a>
        ) : null}
      </div>

      <p class="shop-muted" style="text-align: center; margin-top: 16px">{copy.keepThisLink}</p>
    </div>
  )}
</ShopLayout>

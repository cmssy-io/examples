---
import { loadCmssyPage } from "@cmssy/astro";
import { resolveEditorBlockData, resolveEditorLayoutBlockData } from "@cmssy/react";
import { blocks } from "../cmssy/blocks";
import { cmssy } from "../cmssy.config";
import { Blocks } from "../components/Blocks";
import NotFound from "../components/shop/not-found.astro";
import ShopLayout from "../layouts/shop-layout.astro";
import { localizedText } from "../lib/localized";
import { fetchPageMeta } from "../services/seo";
import { loadShopChrome, type ShopChrome } from "../shop/chrome";
import { shopPageState } from "../shop/page-state";

export const prerender = false;

const [state, cmssyPage] = await Promise.all([
  shopPageState(Astro),
  loadCmssyPage(cmssy, Astro.request, Astro.url, {
    prerendered: Astro.isPrerendered,
  }),
]);
const { page, layouts, pageContext, locale, defaultLocale, enabledLocales } =
  cmssyPage;

if (!page) {
  Astro.response.status = 404;
}

async function pageChrome(): Promise<ShopChrome> {
  const [header, footer] = await Promise.all(
    (["header", "footer"] as const).map((region) =>
      resolveEditorLayoutBlockData({
        groups: layouts,
        blocks,
        region,
        page: pageContext,
        locale,
        defaultLocale,
        enabledLocales,
        config: cmssy,
      }),
    ),
  );
  return { layouts, header, footer };
}

const [chrome, { data: blockData, content: blockContent }, meta] =
  await Promise.all([
    page ? pageChrome() : loadShopChrome(locale),
    resolveEditorBlockData({
      page,
      blocks,
      locale,
      defaultLocale,
      enabledLocales,
      config: cmssy,
    }),
    page?.slug ? fetchPageMeta(page.slug) : null,
  ]);

const title =
  localizedText(meta?.seoTitle, { locale, defaultLocale }) ||
  localizedText(meta?.displayName, { locale, defaultLocale }) ||
  "cmssy on Astro";
const description = localizedText(meta?.seoDescription, { locale, defaultLocale });
---

<ShopLayout state={state} chrome={chrome} title={title} description={description}>
  {
    page ? (
      <Blocks
        page={page}
        location={state.location}
        blockData={blockData}
        blockContent={blockContent}
      />
    ) : (
      <NotFound location={state.location} />
    )
  }
</ShopLayout>

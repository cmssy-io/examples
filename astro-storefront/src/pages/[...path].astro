---
import { loadCmssyPage } from "@cmssy/astro";
import {
  resolveCmssyLayoutSlot,
  resolveEditorBlockData,
  resolveEditorLayoutBlockData,
} from "@cmssy/react";
import { blocks } from "../cmssy/blocks";
import { cmssy } from "../cmssy.config";
import { Blocks } from "../components/Blocks";
import { Region } from "../components/Region";
import { pickLocalized } from "../lib/locale-path";
import { fetchPageMeta } from "../services/seo";

export const prerender = false;

const { page, layouts, pageContext, locale, defaultLocale, enabledLocales } =
  await loadCmssyPage(cmssy, Astro.request, Astro.url, {
    prerendered: Astro.isPrerendered,
  });

if (!page) {
  Astro.response.status = 404;
}

const { data: blockData, content: blockContent } = await resolveEditorBlockData({
  page,
  blocks,
  locale,
  defaultLocale,
  enabledLocales,
  config: cmssy,
});

// The header and the footer live in the workspace, on the homepage, and every
// page inherits them - so they are content, resolved the same way the page's own
// blocks are, not chrome hard-coded into this layout.
//
// A URL with no page behind it inherits nothing, which would leave the 404 the
// only page on the site with no way off it. The regions of "/" are the site's
// own, so that is what it gets.
const regionGroups = page
  ? layouts
  : (
      await resolveCmssyLayoutSlot(cmssy, {
        region: "header",
        blocks,
        editMode: false,
        path: [],
        locale,
      })
    ).groups;

const [header, footer] = await Promise.all(
  (["header", "footer"] as const).map((region) =>
    resolveEditorLayoutBlockData({
      groups: regionGroups,
      blocks,
      region,
      page: pageContext,
      locale,
      defaultLocale,
      enabledLocales,
      config: cmssy,
    }),
  ),
);

const meta = page?.slug ? await fetchPageMeta(page.slug) : null;
const title =
  pickLocalized(meta?.seoTitle, locale, defaultLocale) ||
  pickLocalized(meta?.displayName, locale, defaultLocale) ||
  "cmssy on Astro";
const description = pickLocalized(meta?.seoDescription, locale, defaultLocale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
  </head>
  <body>
    <Region
      groups={regionGroups}
      region="header"
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      blockData={header.data}
      blockContent={header.content}
    />
    {
      page ? (
        <Blocks
          page={page}
          locale={locale}
          defaultLocale={defaultLocale}
          enabledLocales={enabledLocales}
          blockData={blockData}
          blockContent={blockContent}
        />
      ) : (
        <main><h1>Not found</h1></main>
      )
    }
    <Region
      groups={regionGroups}
      region="footer"
      locale={locale}
      defaultLocale={defaultLocale}
      enabledLocales={enabledLocales}
      blockData={footer.data}
      blockContent={footer.content}
    />
  </body>
</html>

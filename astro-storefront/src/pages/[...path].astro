---
import { loadCmssyPage } from "@cmssy/astro";
import { resolveEditorBlockData } from "@cmssy/react";
import { blocks } from "../cmssy/blocks";
import { cmssy } from "../cmssy.config";
import { Blocks } from "../components/Blocks";
import { pickLocalized } from "../lib/locale-path";
import { fetchPageMeta } from "../services/seo";

export const prerender = false;

const { page, locale, defaultLocale, enabledLocales } = await loadCmssyPage(
  cmssy,
  Astro.request,
  Astro.url,
);

if (!page) {
  Astro.response.status = 404;
}

const { data: blockData } = await resolveEditorBlockData({
  page,
  blocks,
  locale,
  defaultLocale,
  enabledLocales,
  config: cmssy,
});

const meta = page?.slug ? await fetchPageMeta(page.slug) : null;
const title =
  pickLocalized(meta?.seoTitle, locale, defaultLocale) ||
  pickLocalized(meta?.displayName, locale, defaultLocale) ||
  "cmssy on Astro";
const description = pickLocalized(meta?.seoDescription, locale, defaultLocale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
  </head>
  <body>
    {
      page ? (
        <Blocks
          page={page}
          locale={locale}
          defaultLocale={defaultLocale}
          enabledLocales={enabledLocales}
          blockData={blockData}
        />
      ) : (
        <main><h1>Not found</h1></main>
      )
    }
  </body>
</html>

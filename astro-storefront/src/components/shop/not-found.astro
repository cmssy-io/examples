---
import { localePath, stripLocalePrefix } from "../../lib/locale-path";
import { copyFor } from "../../lib/shop-copy";
import type { ShopLocation } from "./locale-ui";

const FULL_SHOP_SCREEN = /^\/(?:account|quick-order)\/?$/;

interface Props {
  location: ShopLocation;
}

const { location } = Astro.props;
const copy = copyFor(location.locale);
const catalogHref = localePath("/c/all", location.locale, location.defaultLocale);
const fullShopScreen = FULL_SHOP_SCREEN.test(
  stripLocalePrefix(location.pathname, location),
);
---

<div class="shop-card not-found">
  <div class="code" aria-hidden>404</div>
  <h1>{fullShopScreen ? copy.fullShopOnlyTitle : copy.notFoundTitle}</h1>
  <p class="shop-muted">{fullShopScreen ? copy.fullShopOnlyBody : copy.notFoundBody}</p>
  <a href={catalogHref} class="shop-btn shop-btn-primary">{copy.backToCatalog}</a>
</div>

<style>
  .not-found {
    max-width: 520px;
    margin: 48px auto;
    padding: 56px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .code {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--muted-foreground);
  }
  h1 {
    font-size: var(--text-xl);
    margin: 0;
  }
  p {
    max-width: 42ch;
    margin: 0;
  }
  a {
    margin-top: 12px;
  }
</style>

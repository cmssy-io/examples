{
  "name": "cmssy-example-catalog-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference integration: move a wholesale product catalog from SQL Server into cmssy through the admin GraphQL API.",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "sync": "tsx --env-file-if-exists=.env src/sync.ts",
    "replay": "tsx --env-file-if-exists=.env src/sync.ts --replay",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mssql": "^12.7.2"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.1.2"
}

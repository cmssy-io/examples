# Points at the public cmssy demo workspace, so this example renders real content on a
# fresh clone with no cmssy account. Copy to .env.local and run.
#
# For your own workspace: npx @cmssy/cli link --token cs_...

CMSSY_ORG_SLUG=cmssy
CMSSY_WORKSPACE_SLUG=cmssy-demo

# Only verified for draft preview and editing, which need your own workspace.
CMSSY_DRAFT_SECRET=example-placeholder-draft-secret

# Signs cart/customer session cookies. Any long random string; generate your own
# for anything you deploy: openssl rand -base64 32
CMSSY_SESSION_SECRET=example-placeholder-session-secret-change-me

# The public origin, used for canonical URLs, hreflang and the sitemap. On Vercel,
# VERCEL_PROJECT_PRODUCTION_URL stands in for it; off Vercel a deploy without this
# emits a sitemap of localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Card payment with Stripe Checkout, test mode. Optional, and only all three
# together turn it on: with one or two set the shop stays on the invoice flow.
# Without them checkout places the order and the confirmation page says
# "awaiting payment", which is the net-30 flow. cmssy never sees these keys -
# the order is the record, the payment happens here and is reported back.
#
# STRIPE_SECRET_KEY      sk_test_... from dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET  whsec_... for an endpoint at <origin>/api/stripe/webhook
#                        subscribed to checkout.session.completed and
#                        checkout.session.async_payment_succeeded (locally:
#                        stripe listen --forward-to localhost:3000/api/stripe/webhook)
# CMSSY_API_TOKEN        cs_... from cmssy dashboard -> Settings -> API tokens,
#                        created by a member whose role can manage orders - the
#                        token acts as that member. Server-only: the webhook uses
#                        it to record the payment on the order, and cart, order
#                        and member-auth calls send it with the shopper's address
#                        so per-address limits count shoppers, not this server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CMSSY_API_TOKEN=

# Shipping with Shippo (USPS, DHL Express, Deutsche Post). Optional:
# without its variables it is off and its orders are shipped by hand. Needs
# CMSSY_API_TOKEN above.
#
# CMSSY_WEBHOOK_SECRET    signing secret of a cmssy webhook at <origin>/api/cmssy/webhook
#                         subscribed to order.paid (dashboard -> Settings -> Webhooks)
# SHIPPO_API_TOKEN        apps.goshippo.com -> Settings -> API; a shippo_test_ token buys
#                         free test labels. Activate DHL Express under Settings -> Carriers
# SHIPPO_ADDRESS_FROM_US  object_id of a Shippo address (POST /addresses) for the US warehouse
# SHIPPO_ADDRESS_FROM_DE  the same for the German warehouse
# SHIPPO_CUSTOMS_SIGNER   the name certifying customs declarations for parcels leaving the EU or US
# SHIPPO_WEBHOOK_TOKEN    a random string; Shippo webhooks for track_updated and transaction_created
#                         point at <origin>/api/shippo/webhook?token=<it> (Settings -> Webhooks)
CMSSY_WEBHOOK_SECRET=
SHIPPO_API_TOKEN=
SHIPPO_ADDRESS_FROM_US=
SHIPPO_ADDRESS_FROM_DE=
SHIPPO_CUSTOMS_SIGNER=
SHIPPO_WEBHOOK_TOKEN=

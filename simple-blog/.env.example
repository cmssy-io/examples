# Points at the public cmssy demo workspace, so this example renders real content
# on a fresh clone with no cmssy account. Copy to .env.local and run.
#
# To point it at your own workspace instead:
#   npx @cmssy/cli link --token cs_...
# which rewrites the three CMSSY_* values below.

CMSSY_ORG_SLUG=cmssy
CMSSY_WORKSPACE_SLUG=cmssy-demo

# Published content is served without a token, so any string works here as long
# as the editor URL carries the same one. Draft preview against the shared demo
# workspace is not offered - use your own workspace and its real secret for that.
CMSSY_DRAFT_SECRET=example-placeholder-draft-secret

# Your own public origin - used for canonical URLs, hreflang and the sitemap.
# The CMS stores canonical content, never your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

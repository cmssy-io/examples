# Points at the public cmssy demo workspace, so this example renders real content on a
# fresh clone with no cmssy account. Copy to .env.local and run.
#
# For your own workspace: npx @cmssy/cli link --token cs_...

CMSSY_ORG_SLUG=cmssy
CMSSY_WORKSPACE_SLUG=cmssy-demo

# Only verified for draft preview and editing, which need your own workspace. Any
# non-blank value renders the published demo pages, but /api/draft returns 500
# below 16 characters, so keep the placeholder at least that long.
CMSSY_DRAFT_SECRET=example-placeholder-draft-secret

# Your own public origin - used for canonical URLs, hreflang and the sitemap.
# The CMS stores canonical content, never your domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
